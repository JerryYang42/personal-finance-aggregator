# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# API Keys (Required)
# Get your API keys from: https://www.trading212.com/en/Trading-API
TRADING212_STOCKS_ISA_API_KEY=your_api_key_here
TRADING212_STOCKS_ISA_SECRET_KEY=your_secret_key_here

# Get a free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Server Configuration
PORT=3000

# SSL Certificate (Optional - for corporate proxies like Zscaler)
# Leave empty if not behind corporate proxy
# Example for macOS: SSL_CERT_FILE=${HOME}/zscalar/ZscalerRootCertificate-2048-SHA256.crt
# Example for Linux: SSL_CERT_FILE=/path/to/certificate.crt
SSL_CERT_FILE=
